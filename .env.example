# Host ports only — the services always reach each other on the compose
# network using the standard ports. Override when something already owns them.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDPANDA_PORT=19092
REDPANDA_ADMIN_PORT=9644
WATCHERS_GRPC_PORT=4317
WATCHERS_HTTP_PORT=4318

# Auth
DEX_PORT=5556
# Change both of these outside development.
WATCHERS_OIDC_CLIENT_SECRET=dev-client-secret
WATCHERS_SESSION_SECRET=dev-session-secret-change-me
